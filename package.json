{
  "name": "reversa-mvp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/server.mjs",
    "start:production": "node scripts/server.mjs --production",
    "test": "node scripts/test.mjs && node scripts/test-intelligence.mjs && node scripts/test-scenarios.mjs && node scripts/test-production.mjs && node scripts/load-test.mjs && node scripts/test-receipt.mjs && node scripts/test-provider-rpc.mjs",
    "verify:provider": "node scripts/verify-provider.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run --outdir dist/deploy-check",
    "verify:mainnet": "node scripts/verify-mainnet.mjs",
    "validate": "node scripts/validate-artifact.mjs",
    "engines:check": "node --version"
  },
  "dependencies": {
    "viem": "2.57.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.151.1"
  }
}
