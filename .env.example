# Optional dedicated endpoints. Keep credentials in .env, which is gitignored.
# A provider must enable debug_traceTransaction with callTracer on Robinhood mainnet.
# ROBINHOOD_MAINNET_RPC=https://YOUR_PROVIDER_ENDPOINT
# ROBINHOOD_TESTNET_RPC=https://YOUR_TESTNET_ENDPOINT
# Optional local metrics access; choose a long random token.
# METRICS_TOKEN=YOUR_RANDOM_TOKEN
# VERIFICATION_CASES=verification-cases.json
